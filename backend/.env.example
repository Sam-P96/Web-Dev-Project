MONGODB_URI="enter-your-mongodb-uri"
# Separate database for `npm test` (tests delete data!). e.g. mongodb://localhost:27017/autotori_test
MONGODB_URI_TEST="enter-your-test-mongodb-uri"
PORT=4000
# run this cmd to generate random string node -e "console.log(require('crypto').randomBytes(64).toString('hex'))" then use it for secret key
SECRET="enter-your-secret-key"

# Gemini API key for the chatbot (https://aistudio.google.com/apikey). Backend only, never VITE_*
LLM_API_KEY="enter-your-gemini-api-key"
# Optional, defaults to gemini-3.5-flash-lite
LLM_MODEL=""
